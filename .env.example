# ============ AuraCraft Discord Botu ============
# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Discord sunucunun ID'si (komutlar anında görünür)
GUILD_ID=

# Minecraft sunucusu (değiştirmen gerekmez)
MC_AD=AuraCraft
MC_ADRES=auracraft.net.tr
# java ya da bedrock
MC_TUR=java

# --- Konsol bağlantısı (RCON) ---
# Hesap doğrulama, bağlama ödülleri, market teslimatı, whitelist ve oyun içi yönetim bununla çalışır.
# server.properties içinde:  enable-rcon=true   rcon.port=25575   rcon.password=GucluBirSifre
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# Şarkı araması için yt-dlp bulunamazsa otomatik indirilsin mi? (0 = hayır)
YTDLP_OTOMATIK_INDIR=1
TZ=Europe/Istanbul
