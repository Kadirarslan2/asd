# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# Sunucunun ID'si: komutlar anında görünür. (Boş bırakılırsa global kayıt olur, 1 saate kadar sürebilir.)
GUILD_ID=

# --- İsteğe bağlı: Minecraft sunucu konsoluna bağlantı (RCON) ---
# Başvuru onaylanınca otomatik whitelist, marketten oyun içi ödül ve /mc rcon komutu için gerekir.
# server.properties içinde:  enable-rcon=true   rcon.port=25575   rcon.password=GucluBirSifre
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# Şarkı araması için yt-dlp bulunamazsa otomatik indirilsin mi? (0 = hayır)
YTDLP_OTOMATIK_INDIR=1
TZ=Europe/Istanbul
