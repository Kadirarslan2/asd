# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# (İsteğe bağlı) Komutların anında görünmesi için test sunucunun ID'si. Boşsa komutlar global kaydedilir (yayılması 1 saate kadar sürebilir).
GUILD_ID=
# https://developers.faceit.com > App Studio > API Keys (Server side key)
FACEIT_API_KEY=
# https://steamcommunity.com/dev/apikey (isteğe bağlı, /steam komutu için)
STEAM_API_KEY=
# 3D kamp ateşi web sunucusu
WEB_PORT=3000
# Kullanıcıların tarayıcıdan erişeceği adres (VDS'te http://SUNUCU_IP:3000 veya alan adın)
PUBLIC_URL=http://localhost:3000
TZ=Europe/Istanbul
# Şarkı araması için yt-dlp bulunamazsa otomatik indirilsin mi? (0 = hayır)
YTDLP_OTOMATIK_INDIR=1
