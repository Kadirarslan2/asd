# Bu dosyayı ".env" adıyla kopyalayın ve yalnızca kullanacağınız servislerin anahtarlarını doldurun.
# .env dosyası git'e eklenmez.

# Runway  (https://dev.runwayml.com)
RUNWAYML_API_SECRET=

# Kling   (https://app.klingai.com/global/dev) — Access Key + Secret Key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Google Veo — Gemini API anahtarı (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Senaryo/storyboard yazımı için (isteğe bağlı; yoksa --offline şablon kullanılır)
ANTHROPIC_API_KEY=
